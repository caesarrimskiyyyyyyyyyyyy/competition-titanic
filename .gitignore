# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Virtual environments and local tooling
.venv/
venv/
env/
ENV/

# Secrets and Kaggle credentials
.env
.env.*
!.env.example
kaggle.json
.kaggle/

# Kaggle data is downloaded locally and is not committed
data/raw/*
!data/raw/.gitkeep

# Trained model artifacts
models/*
!models/.gitkeep
*.joblib
*.pkl

# Kaggle submissions
submissions/*
!submissions/.gitkeep

# Experiment tracking and runtime logs
mlruns/
mlartifacts/
mlflow.db
wandb/
logs/
*.log

# Hydra runtime output directories
outputs/
multirun/

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
